                  ".write": "auth != null && root.child('test').child($ns).child('sess').child(auth.uid).child('k').val() === $name && !data.exists()",
                  ".validate": "newData.hasChildren(['ad', 'acik', 'ts']) && newData.child('ad').isString() && newData.child('ad').val().length <= 40 && newData.child('acik').isString() && newData.child('acik').val().length <= 1000"
                }
              }
            },
                    "users": {
          ".read": "auth != null && root.child('test').child($ns).child('sess').child(auth.uid).child('k').val() === 'servet'",
          "$name": {
            ".write": "auth != null && (!data.exists() || root.child('test').child($ns).child('sess').child(auth.uid).child('k').val() === $name)",
            "name": { ".read": true },
            "ts": { ".read": true }
          }
        },
        "sess": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.child('k').isString() && newData.child('pin').val() === root.child('test').child($ns).child('users').child(newData.child('k').val()).child('pin').val()"
          }
        },
        "online": {
