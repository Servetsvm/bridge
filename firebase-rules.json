            ".write": "(auth != null && root.child('sess').child(auth.uid).child('k').val() === 'servet') || (auth != null && root.child('gate').child('clubs').child($club).child('info').child('owner').val() === root.child('sess').child(auth.uid).child('k').val()) || (auth != null && root.child('gate').child('tsess').child(auth.uid).child('club').val() === $club && root.child('gate').child('tsess').child(auth.uid).child('code').isString() && root.child('gate').child('clubs').child($club).child('secret').child('tprefix').isString() && root.child('gate').child('tsess').child(auth.uid).child('code').val().beginsWith(root.child('gate').child('clubs').child($club).child('secret').child('tprefix').val()))"
          }
        }
      },
      "owners": {
        "$k": {
          ".read": "auth != null && (root.child('sess').child(auth.uid).child('k').val() === $k || root.child('sess').child(auth.uid).child('k').val() === 'servet')",
          ".write": "auth != null && (root.child('sess').child(auth.uid).child('k').val() === $k || root.child('sess').child(auth.uid).child('k').val() === 'servet')"
        }
      },
      "tsess": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (newData.child('club').isString() && newData.child('code').isString() && newData.child('code').val().matches(/^[0-9]{4}$/) && root.child('gate').child('clubs').child(newData.child('club').val()).child('info').child('active').val() !== false && newData.child('code').val().beginsWith(root.child('gate').child('clubs').child(newData.child('club').val()).child('secret').child('tprefix').val())))"
        }
      }
    }
  }
}
