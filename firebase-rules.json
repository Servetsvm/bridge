          "$name": { ".write": "auth != null && root.child('test').child($ns).child('sess').child(auth.uid).child('k').val() === $name" }
        },
        "logins": {
          ".read": "auth != null && root.child('test').child($ns).child('sess').child(auth.uid).child('k').val() === 'servet'",
          "$day": { "$name": { ".write": "auth != null && root.child('test').child($ns).child('sess').child(auth.uid).child('k').val() === $name" } }
        },
        "data": {
          "$k": {
            ".read": "auth != null && root.child('test').child($ns).child('sess').child(auth.uid).child('pin').val() === $k && root.child('test').child($ns).child('users').child(root.child('test').child($ns).child('sess').child(auth.uid).child('k').val()).child('pin').val() === $k",
            ".write": "auth != null && root.child('test').child($ns).child('sess').child(auth.uid).child('pin').val() === $k && root.child('test').child($ns).child('users').child(root.child('test').child($ns).child('sess').child(auth.uid).child('k').val()).child('pin').val() === $k"
          }
        }
      }
    }
  }
}
